{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [{
          "type": "command",
          "command": ".claude/hooks/auto-compile-latex.sh"
        }]
      },
      {
        "matcher": "Edit",
        "hooks": [{
          "type": "command",
          "command": ".claude/hooks/auto-commit-push.sh"
        }]
      },
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "if": "Bash(compile\\.sh)",
          "command": ".claude/hooks/check-label-cite.sh"
        }]
      },
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "if": "Bash(compile\\.sh)",
          "command": ".claude/hooks/auto-commit-push.sh"
        }]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "UserPromptSubmit",
        "hooks": [{
          "type": "command",
          "command": ".claude/hooks/qa-reminder.sh"
        }]
      }
    ],
    "Stop": [
      {
        "matcher": "Stop",
        "hooks": [{
          "type": "command",
          "command": ".claude/hooks/qa-reminder.sh"
        }]
      }
    ]
  }
}
