{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "command": ".claude/hooks/block-playwright-cache.sh"
        }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [{
          "type": "command",
          "command": ".claude/hooks/auto-compile-latex.sh"
        }]
      },
      {
        "matcher": "Edit",
        "hooks": [{
          "type": "command",
          "command": ".claude/hooks/auto-commit-push.sh"
        }]
      },
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "if": "Bash(compile\\.sh)",
          "command": ".claude/hooks/check-label-cite.sh"
        }]
      },
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "if": "Bash(compile\\.sh)",
          "command": ".claude/hooks/auto-commit-push.sh"
        }]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "UserPromptSubmit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/qa-reminder.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/expert-dispatcher.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "Stop",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/compact-reload.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/save-btw-history.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "SessionStart",
        "hooks": [{
          "type": "command",
          "command": ".claude/hooks/pua-session-start.sh"
        }]
      }
    ],
    "PreCompact": [
      {
        "matcher": "PreCompact",
        "hooks": [{
          "type": "command",
          "command": ".claude/hooks/pua-precompact.sh"
        }]
      }
    ]
  }
}
